<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NexoraApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NexoraApp"
    xmlns:views="clr-namespace:NexoraApp.Views"
    xmlns:info="clr-namespace:Microsoft.Maui.ApplicationModel;assembly=Microsoft.Maui.Essentials"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource White}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource White}}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource FondoSuave}, Dark={StaticResource OffBlack}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource Primary}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource Primary}}"
    Shell.TabBarUnselectedColor="{StaticResource Gray500}"
    Title="Nexora">

    <!-- Encabezado del menú lateral -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}" HeightRequest="150" Padding="18">
            <VerticalStackLayout VerticalOptions="End" Spacing="8">
                <Border WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 16"
                        StrokeThickness="0" BackgroundColor="{StaticResource Texto}" HorizontalOptions="Start">
                    <Label Text="N" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Nexora" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Pie del menú lateral -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="18">
            <Label Text="{x:Static info:AppInfo.Name}" />
            <Label Text="{x:Static info:AppInfo.VersionString}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <!-- Barra de pestañas: Inicio, Proyectos, Tareas y Perfil -->
    <FlyoutItem Title="Nexora">
        <Tab Title="Inicio" Icon="icono_inicio.svg">
            <ShellContent
                Title="Inicio"
                ContentTemplate="{DataTemplate views:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Proyectos" Icon="icono_proyectos.svg">
            <ShellContent
                Title="Proyectos"
                ContentTemplate="{DataTemplate views:ProyectosPage}"
                Route="ProyectosPage" />
        </Tab>

        <Tab Title="Tareas" Icon="icono_tareas.svg">
            <ShellContent
                Title="Tareas"
                ContentTemplate="{DataTemplate views:TareasPage}"
                Route="TareasPage" />
        </Tab>

        <Tab Title="Perfil" Icon="icono_perfil.svg">
            <ShellContent
                Title="Perfil"
                ContentTemplate="{DataTemplate views:PerfilPage}"
                Route="PerfilPage" />
        </Tab>
    </FlyoutItem>

    <ShellContent
        Title="Equipo"
        ContentTemplate="{DataTemplate views:EquipoPage}"
        Route="EquipoPage" />

    <ShellContent
        Title="Acerca de Nexora"
        ContentTemplate="{DataTemplate views:AboutPage}"
        Route="AboutPage" />

    <!-- Menú que abre una página web -->
    <MenuItem
        Text="Documentación de .NET MAUI"
        Clicked="MenuItem_Clicked" />

</Shell>
