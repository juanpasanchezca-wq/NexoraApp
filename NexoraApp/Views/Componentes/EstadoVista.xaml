<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexoraApp.Views.Componentes.EstadoVista">

    <!-- Se usa para "vacío" y para "error": icono, título, mensaje y un botón opcional -->
    <VerticalStackLayout Spacing="12" Padding="24,40" HorizontalOptions="Center" MaximumWidthRequest="320">
        <Border x:Name="circulo" WidthRequest="96" HeightRequest="96" StrokeShape="Ellipse" StrokeThickness="0"
                HorizontalOptions="Center">
            <Image x:Name="icono" WidthRequest="44" HeightRequest="44"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <Label x:Name="tituloLabel" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        <Label x:Name="mensajeLabel" FontSize="14" Opacity="0.7" HorizontalTextAlignment="Center" />
        <Button x:Name="boton" Clicked="OnBotonClicked" Margin="0,8,0,0"
                BackgroundColor="#E67514" TextColor="#212121" FontAttributes="Bold"
                CornerRadius="24" Padding="24,0" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentView>
