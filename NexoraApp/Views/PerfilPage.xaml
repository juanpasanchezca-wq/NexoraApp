<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NexoraApp.Views"
             x:Class="NexoraApp.Views.PerfilPage"
             Title="Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Datos del usuario -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,8,0,0">
                <Border x:Name="avatar" WidthRequest="88" HeightRequest="88" StrokeShape="Ellipse" StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Label x:Name="inicialesLabel" FontSize="30" FontAttributes="Bold" TextColor="#212121"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="nombreLabel" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label x:Name="correoLabel" FontSize="13" Opacity="0.75" HorizontalOptions="Center" />
                <Border x:Name="rolChip" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4"
                        HorizontalOptions="Center">
                    <Label x:Name="rolLabel" FontSize="12" FontAttributes="Bold" />
                </Border>
            </VerticalStackLayout>

            <!-- Resumen personal -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label x:Name="proyectosLabel" FontSize="24" FontAttributes="Bold" />
                        <Label Text="Proyectos" FontSize="12" Opacity="0.7" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label x:Name="pendientesLabel" FontSize="24" FontAttributes="Bold" TextColor="#E67514" />
                        <Label Text="Pendientes" FontSize="12" Opacity="0.7" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout>
                        <Label x:Name="hechasLabel" FontSize="24" FontAttributes="Bold" TextColor="#06923E" />
                        <Label Text="Completadas" FontSize="12" Opacity="0.7" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Apariencia -->
            <Label Text="Apariencia" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0" />
            <Grid x:Name="temaGrid" ColumnDefinitions="*,*,*" ColumnSpacing="8" />
            <Label Text="El tema se guarda y se aplica cada vez que abres la app." FontSize="12" Opacity="0.65" />

            <!-- Notificaciones -->
            <Label Text="Notificaciones" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border StrokeShape="RoundRectangle 14" Padding="14,4">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <Label Text="Recibir notificaciones" VerticalOptions="Center" />
                        <Switch x:Name="notifSwitch" Grid.Column="1" OnColor="#E67514" Toggled="OnNotifToggled" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#33808080" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVerNotificacionesTapped" />
                        </Grid.GestureRecognizers>
                        <Image Source="icono_campana_gris.svg" WidthRequest="20" HeightRequest="20" />
                        <Label Grid.Column="1" Text="Ver notificaciones" VerticalOptions="Center" />
                        <Border x:Name="sinLeerChip" Grid.Column="2" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                Padding="8,2" BackgroundColor="#E67514" VerticalOptions="Center">
                            <Label x:Name="sinLeerLabel" FontSize="11" FontAttributes="Bold" TextColor="#212121" />
                        </Border>
                        <Image Grid.Column="3" Source="icono_chevron.svg" WidthRequest="20" HeightRequest="20" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Mis tareas pendientes -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <Label Text="Mis tareas pendientes" FontSize="16" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Ver todas" FontSize="13" TextColor="#E67514" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVerTodasTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Label x:Name="sinTareasLabel" Text="No tienes tareas pendientes." Opacity="0.7" IsVisible="False" />
            <VerticalStackLayout x:Name="listaTareas" Spacing="10" Margin="0,0,0,24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:TareaFila">
                        <Border StrokeShape="RoundRectangle 14" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTareaTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="6,*" ColumnSpacing="12">
                                <BoxView Color="{Binding ColorEstado}" CornerRadius="3" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                    <Label Text="{Binding Detalle}" FontSize="12" Opacity="0.75" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked"
                    BackgroundColor="Transparent" BorderColor="#D32F2F" BorderWidth="1"
                    TextColor="#D32F2F" CornerRadius="22" Margin="0,0,0,24" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
