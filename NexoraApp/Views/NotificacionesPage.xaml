<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NexoraApp.Views"
             xmlns:comp="clr-namespace:NexoraApp.Views.Componentes"
             x:Class="NexoraApp.Views.NotificacionesPage"
             Title="Notificaciones">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Marcar leídas" Order="Primary" Clicked="OnMarcarLeidasClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label x:Name="resumenLabel" FontSize="14" Opacity="0.75" />

            <comp:EstadoVista x:Name="estadoVista" IsVisible="False" />

            <VerticalStackLayout x:Name="lista" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:NotificacionItem">
                        <Border StrokeShape="RoundRectangle 14" Padding="12" BackgroundColor="{Binding Fondo}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificacionTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="12" HeightRequest="12" StrokeShape="Ellipse" StrokeThickness="0"
                                        BackgroundColor="{Binding ColorTipo}" VerticalOptions="Start" Margin="0,5,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                    <Label Text="{Binding Mensaje}" FontSize="13" Opacity="0.85" />
                                    <Label Text="{Binding Cuando}" FontSize="11" Opacity="0.6" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" WidthRequest="10" HeightRequest="10" StrokeShape="Ellipse" StrokeThickness="0"
                                        BackgroundColor="#E67514" VerticalOptions="Start" Margin="0,5,0,0"
                                        IsVisible="{Binding NoLeida}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
