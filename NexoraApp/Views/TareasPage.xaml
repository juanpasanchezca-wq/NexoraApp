<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:handlers="clr-namespace:NexoraApp.Handlers"
             x:Class="NexoraApp.Views.TareasPage"
             Title="Tareas">

    <Shell.SearchHandler>
        <handlers:TareaBusquedaHandler
            Placeholder="Buscar tarea"
            DisplayMemberName="Titulo"
            ShowsResults="True" />
    </Shell.SearchHandler>

    <ScrollView>
        <VerticalStackLayout x:Name="container" Padding="16" Spacing="10">
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
