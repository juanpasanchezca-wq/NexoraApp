<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:NexoraApp.Views"
             xmlns:conv="clr-namespace:NexoraApp.Converters"
             x:Class="NexoraApp.Views.TareaDetailPage"
             Title="Tarea">

    <!-- Convertidores de valores (Clase 9): modelo -> vista -->
    <ContentPage.Resources>
        <conv:EstadoColorConverter x:Key="EstadoColor" />
        <conv:PrioridadColorConverter x:Key="PrioridadColor" />
        <conv:BoolATachadoConverter x:Key="BoolATachado" />
        <conv:BoolAOpacidadConverter x:Key="BoolAOpacidad" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Order="Primary" Priority="0" Command="{Binding EditarTareaCommand}"
                     IconImageSource="{AppThemeBinding Light=icono_editar.svg, Dark=icono_editar_claro.svg}" />
        <ToolbarItem Order="Primary" Priority="1" Command="{Binding EliminarTareaCommand}"
                     IconImageSource="{AppThemeBinding Light=icono_eliminar.svg, Dark=icono_eliminar_claro.svg}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Encabezado -->
            <HorizontalStackLayout Spacing="8">
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4"
                        BackgroundColor="{Binding Estado, Converter={StaticResource EstadoColor}}">
                    <Label Text="{Binding Estado}" FontSize="12" FontAttributes="Bold" TextColor="#212121" />
                </Border>
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,4"
                        BackgroundColor="{Binding Prioridad, Converter={StaticResource PrioridadColor}}">
                    <Label Text="{Binding PrioridadTexto}" FontSize="12" FontAttributes="Bold" />
                </Border>
            </HorizontalStackLayout>
            <Label Text="{Binding Titulo}" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding Descripcion}" FontSize="14" Opacity="0.8" />

            <!-- Proyecto / Responsable / Fecha -->
            <Border StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="icono_carpeta.svg" WidthRequest="18" HeightRequest="18" />
                        <Label Text="{Binding Proyecto}" Grid.Column="1" TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IrAProyectoCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border WidthRequest="26" HeightRequest="26" StrokeShape="Ellipse" StrokeThickness="0"
                                BackgroundColor="{Binding AvatarColor}">
                            <Label Text="{Binding Iniciales}" FontSize="10" FontAttributes="Bold" TextColor="#212121"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding Responsable}" Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="icono_calendario_gris.svg" WidthRequest="18" HeightRequest="18" />
                        <Label Text="{Binding FechaTexto}" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cambiar estado -->
            <Label Text="Cambiar estado" FontSize="16" FontAttributes="Bold" />
            <Grid x:Name="estadoGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" />

            <!-- Subtareas -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Subtareas" FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding SubtareasContador}" Grid.Column="1" FontSize="13" Opacity="0.7" />
            </Grid>
            <ProgressBar Progress="{Binding SubtareasProgreso}" ProgressColor="#E67514" />
            <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Subtareas}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <CheckBox Grid.Column="0" IsChecked="{Binding Completada, Mode=TwoWay}" Color="#E67514" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Titulo}" VerticalOptions="Center"
                                   TextDecorations="{Binding Completada, Converter={StaticResource BoolATachado}}"
                                   Opacity="{Binding Completada, Converter={StaticResource BoolAOpacidad}}" />
                            <Label Grid.Column="2" Text="✕" FontSize="16" Opacity="0.6" VerticalOptions="Center" Padding="8,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EliminarCommand}" CommandParameter="{Binding Id}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Text="{Binding NuevaSubtarea, Mode=TwoWay}" Placeholder="Nueva subtarea" ReturnType="Done" ReturnCommand="{Binding AgregarSubtareaCommand}" />
                <Button Grid.Column="1" Text="Añadir" Command="{Binding AgregarSubtareaCommand}"
                        BackgroundColor="#E67514" TextColor="#212121" CornerRadius="20" />
            </Grid>

            <!-- Comentarios -->
            <Label Text="{Binding Comentarios.Count, StringFormat='Comentarios ({0})'}" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Comentarios}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:ComentarioItem">
                        <Border StrokeShape="RoundRectangle 14" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border WidthRequest="32" HeightRequest="32" StrokeShape="Ellipse" StrokeThickness="0"
                                        BackgroundColor="{Binding Fondo}" VerticalOptions="Start">
                                    <Label Text="{Binding Iniciales}" FontSize="11" FontAttributes="Bold" TextColor="#212121"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Autor}" FontAttributes="Bold" FontSize="13" />
                                        <Label Grid.Column="1" Text="{Binding Fecha}" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                    <Label Text="{Binding Texto}" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,24">
                <Entry Text="{Binding NuevoComentario, Mode=TwoWay}" Placeholder="Escribe un comentario" ReturnType="Send" ReturnCommand="{Binding EnviarComentarioCommand}" />
                <Button Grid.Column="1" Text="Enviar" Command="{Binding EnviarComentarioCommand}"
                        BackgroundColor="#E67514" TextColor="#212121" CornerRadius="20" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>